# Local API configuration. Generate separate random 32-byte keys (64 hex characters).
# Never use example placeholders as real secrets or commit real values.
DATABASE_URL=postgresql://transproxy:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/transproxy
CORS_ORIGINS=http://localhost:5328
PORT=3028
WAITLIST_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
WAITLIST_LOOKUP_KEY=REPLACE_WITH_DIFFERENT_64_RANDOM_HEX_CHARACTERS
# Production only, after validating Coolify -> nginx -> API ingress chain:
TRUST_PROXY_HOPS=2
# Frontend nginx container only:
API_UPSTREAM=http://transproxy-api-internal:3001

# Optional welcome-email delivery. The queue/database/worker remain self-hosted.
# Set both credentials to enable mail for NEW signups only; no backfill.
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=TransProxy <updates@transproxy.org>
SITE_URL=https://transproxy.org
