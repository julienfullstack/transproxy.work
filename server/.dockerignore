# Do not send repository history or local/private artifacts to Docker builds.
.git
.git/**
# Secrets and local environment configuration
**/.env
**/.env.*
**/*.env
**/*.env.*
!.env.example
!**/.env.example
!*.env.example
!**/*.env.example
/secrets/
**/secrets/
/credentials/
**/credentials/
**/credentials.json
**/service-account*.json
**/serviceAccount*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.keystore
**/*.jks
**/.npmrc.local

# Private records, user uploads and local storage (never source fixtures)
/private/
/private-records/
/patient-records/
/records/
/uploads/
/storage/
/data/
/server/private/
/server/private-records/
/server/patient-records/
/server/records/
/server/uploads/
/server/storage/
/server/data/

# Database exports, snapshots and backups; keep numbered SQL migrations
/dumps/
/database-dumps/
/backups/
/server/dumps/
/server/database-dumps/
/server/backups/
**/*.dump
**/*.sql.gz
**/*.sql.bz2
**/*.sql.xz
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.sqlite3-*
**/*.db
**/*.db-*
**/*.backup
**/*.bak
**/*~

# Logs and runtime process state
**/*.log
logs/
**/*.pid
**/*.pid.lock
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Dependencies, generated output and caches
node_modules/
bower_components/
.pnp.*
.yarn/cache/
dist/
build/
coverage/
.vite/
.next/
.nuxt/
.cache/
.tmp/
tmp/
*.tsbuildinfo
__pycache__/
*.pyc
.venv/
venv/

# Local agent state and editor/OS artifacts
.ai-queues/
ai-queues/
.ai/
.octo-continue.md
.codex/
.claude/
.DS_Store
Thumbs.db
.idea/
.vscode/

# Lockfiles, migrations and synthetic source fixtures are intentionally kept.
# Never place real patient material or secrets in an allowlisted example/fixture.

# Plain SQL exports are private; numbered migrations and synthetic SQL fixtures stay source.
**/*.sql
!server/sql/*.sql
!sql/[0-9][0-9][0-9]_*.sql
!server/src/fixtures/*.sql
!src/fixtures/*.sql
**/.npmrc
**/.netrc
**/.pgpass
**/id_rsa
**/id_ed25519
**/secrets.*
**/*.secret

# Private data at any nesting depth, including local operator exports.
**/private/
**/private-records/
**/patient-records/
**/uploads/
**/.local/records/
**/.local/storage/
**/.local/data/
**/dumps/
**/database-dumps/
**/backups/

# Local key material/configuration, never the public crypto implementation.
**/.keys/
**/key-material/
**/runtime-secrets/
**/encryption-key.*
**/encryption-keys.*
**/lookup-key.*
**/lookup-keys.*
**/key-material.*
**/encryption-config.local.*
**/crypto-config.local.*
**/key-config.local.*
